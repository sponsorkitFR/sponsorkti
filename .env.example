# ══════════════════════════════════════════════════════
# SPONSORKIT — Variables d'environnement
# Copie ce fichier en .env pour le dev local
# Sur Vercel : Settings → Environment Variables
# ══════════════════════════════════════════════════════

# ── ANTHROPIC (IA Chat + Briefs) ──────────────────────
# Obtenir sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REMPLACE_ICI

# ── SUPABASE (Base de données + Auth) ─────────────────
# Obtenir sur : https://supabase.com → ton projet → Settings → API
SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ADMIN DASHBOARD ───────────────────────────────────
# Invente un mot de passe fort — accès au dashboard /dashboard
ADMIN_SECRET=MonMotDePasseAdmin2026!
# N'importe quelle chaîne aléatoire pour hasher les IPs (RGPD)
IP_SALT=sk-salt-xyz-2026

# ── URL DE TON SITE ───────────────────────────────────
# En prod : ton URL Vercel. En dev local : http://localhost:3000
APP_URL=https://sponsorkit-TON_USERNAME.vercel.app

# ── GOOGLE / GMAIL (Email sync niveau 2) ──────────────
# Obtenir sur : https://console.cloud.google.com
# 1. Créer un projet → APIs & Services → Credentials → OAuth 2.0
# 2. Activer : Gmail API
# 3. URI de redirection autorisée : APP_URL/api/email/callback?provider=gmail
GOOGLE_CLIENT_ID=XXXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXXXX

# ── MICROSOFT / OUTLOOK (Email sync niveau 2) ─────────
# Obtenir sur : https://portal.azure.com
# 1. Azure Active Directory → App registrations → New registration
# 2. Redirect URI : APP_URL/api/email/callback?provider=outlook
# 3. API permissions : Mail.Read, offline_access, User.Read
MICROSOFT_CLIENT_ID=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX
MICROSOFT_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── STRIPE (Paiements niveau 3) ───────────────────────
# Obtenir sur : https://dashboard.stripe.com/developers
# 1. API Keys → Secret key (sk_live_... en prod, sk_test_... en test)
# 2. Webhooks → Add endpoint → APP_URL/api/payments/stripe
#    Événements : payment_intent.succeeded
# 3. Récupérer le "Signing secret" du webhook
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXX

# ── PAYPAL (Paiements niveau 3) ───────────────────────
# Obtenir sur : https://developer.paypal.com/dashboard
# 1. My Apps → Create App → récupérer Client ID et Secret
# 2. Webhooks → Add webhook → APP_URL/api/payments/paypal
#    Événements : PAYMENT.CAPTURE.COMPLETED
# 3. Récupérer le Webhook ID
PAYPAL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYPAL_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
PAYPAL_WEBHOOK_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
# sandbox = mode test, production = mode réel
PAYPAL_MODE=sandbox
